{
  "name": "@agency/gaze",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AGENCY OS gaze engine: webcam eye tracking (MediaPipe landmarks), calibration v2, fixation smoothing, dwell, switches, Lifeline's help pattern, precision helpers, providers and benchmarks. Owned by Instance 2.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./webcam": "./src/providers/webcam.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "fixtures": "vitest run --config vitest.bench.config.ts bench/make-fixtures.bench.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\" \"e2e/**/*.ts\" \"engine/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\" \"e2e/**/*.ts\" \"engine/**/*.ts\"",
    "check": "npm run typecheck && npm run format:check && npm test",
    "test:e2e": "playwright test",
    "bench:browser": "BENCH_SECONDS=15 playwright test",
    "build": "vite build --config engine/vite.config.ts",
    "bench:intent": "vitest run --config vitest.bench.config.ts bench/intent.bench.ts",
    "bench:cursor": "vitest run --config vitest.bench.config.ts bench/cursor.bench.ts"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@agency/contracts": "*",
    "@realeye-io/webcam-eyetracker-light-open": "1.1.0"
  }
}
