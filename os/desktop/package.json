{
  "name": "@agency/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "AGENCY OS desktop app (Electron): shell, overlay, gaze host, process supervision, Lifeline and Stop.",
  "main": "out/main/index.cjs",
  "author": "AGENCY",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && playwright test",
    "dist": "node scripts/build.mjs --production && node scripts/dist.mjs"
  },
  "devDependencies": {
    "@agency/contracts": "0.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
