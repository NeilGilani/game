<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AGENCY.app (hardened runtime). Only what the app needs: V8's JIT, the camera for eye tracking, the
     microphone for calls, reading today's Calendar events for My day (read-only, off until a helper turns it on), and Apple events so the texts the person approves can go out through Messages.
     Accessibility, Screen Recording and Automation are TCC permissions, not entitlements. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
