{
  "manifest_version": 3,
  "name": "AGENCY Bridge",
  "version": "0.1.0",
  "description": "Lets AGENCY help you use Chrome with your eyes: big targets for eye control, and an assistant that always asks before anything important.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_title": "AGENCY: turn reading mode on or off" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "128": "icon128.png" }
}
