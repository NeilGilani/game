<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for agency-native. Accessibility and Screen Recording are TCC permissions the
     person grants in System Settings; they have no entitlement. Not sandboxed: the accessibility API and
     posting input events don't work from the App Sandbox. Speech recognition needs only the usage description
     in the embedded Info.plist, not an entitlement. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- My day reads today's Calendar events (read-only), only after a helper turns it on. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
</dict>
</plist>
