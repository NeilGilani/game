# Create a unique token before running. Never commit .env.
CLOUD_API_KEY=replace-with-a-generated-token
CLOUD_ADAPTER_DIR=../../vault-1.5b
CLOUD_BIND_ADDRESS=127.0.0.1
CLOUD_DTYPE=auto
CLOUD_VAULT_MODE=resident
CLOUD_ADAPTER_CACHE_MB=512
CLOUD_GENERATION_RESERVE_MB=1024
CLOUD_MAX_INPUT_TOKENS=4096
CLOUD_MAX_NEW_TOKENS=512
CLOUD_MAX_PENDING_REQUESTS=8
CLOUD_LOCAL_FILES_ONLY=false
# HF_TOKEN=your-token-for-a-gated-base-model
