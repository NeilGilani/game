{
  "name": "agency-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AGENCY OS landing page and download (static, built with Astro).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro-check && tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "links": "node scripts/check-links.mjs dist",
    "lhci": "lhci autorun",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run links"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.56.1"
    }
  }
}
