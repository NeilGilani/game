---
// Small line icons (24 x 24, drawn with the current text colour). Always decorative: the words say it.
interface Props {
  name: keyof typeof paths;
  class?: string;
}

const paths = {
  eye: "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
  sparkles:
    "M12 3l1.8 4.7L18.5 9.5 13.8 11.3 12 16l-1.8-4.7L5.5 9.5l4.7-1.8z M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z",
  check: "M5 12.5l4.5 4.5L19 7.5",
  x: "M6 6l12 12M18 6L6 18",
  bell: "M6 16V11a6 6 0 1 1 12 0v5l2 2H4z M10 20.5a2 2 0 0 0 4 0",
  shield: "M12 3l8 3v6c0 4.6-3.4 8.3-8 9-4.6-.7-8-4.4-8-9V6z M8.5 12l2.5 2.5 4.5-5",
  hand: "M8 13V6.5a1.5 1.5 0 0 1 3 0V12 M11 11.5V5a1.5 1.5 0 0 1 3 0v6.5 M14 11.5V6.5a1.5 1.5 0 0 1 3 0V14c0 4-2.7 7-6.5 7-2.6 0-4.2-1.4-5.6-3.6L3.3 15a1.5 1.5 0 0 1 2.4-1.8L8 15.5",
  chat: "M4 5h16v11H9l-5 4z M8 9.5h8M8 12.5h5",
  network: "M2.5 9a14 14 0 0 1 19 0 M5.5 12.3a9.5 9.5 0 0 1 13 0 M8.6 15.6a5 5 0 0 1 6.8 0 M12 19.2h.01",
  lock: "M6 11h12v10H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3",
  card: "M3 6h18v12H3z M3 10h18 M7 15h3",
  heart: "M12 20s-8-4.7-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.3 12 20 12 20z",
  sandbox: "M4 8l8-4 8 4-8 4z M4 8v8l8 4 8-4V8 M12 12v8",
  doc: "M6 3h8l4 4v14H6z M14 3v4h4 M9 12h6M9 16h6",
  camera: "M4 8h3l2-3h6l2 3h3v11H4z M12 10.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
  arrow: "M5 12h14M13 6l6 6-6 6",
  stop: "M6 6h12v12H6z",
  cpu: "M7 7h10v10H7z M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4",
  wallet: "M4 7h15v12H4z M4 7l11-3v3 M15 13h2",
} as const;

const { name, class: cls } = Astro.props;
---

<svg
  class:list={["icon", cls]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={paths[name]}></path>
</svg>
