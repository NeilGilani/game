---
// A large "next section" link at the end of each section, so gaze and switch users can move through the page
// in steps instead of scrolling. Quiet to look at, but still a full 96 px target.
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<p class="next-section">
  <a class="btn btn-quiet" href={href}>
    <span>Next: {label}</span>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path d="M12 4v15m-6-6l6 6 6-6"></path>
    </svg>
  </a>
</p>
