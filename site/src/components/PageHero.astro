---
// The top of each inner page: a short label, a large title, a lede, and optional extra content.
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-hero">
  <div class="wrap">
    <p class="kicker">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>
