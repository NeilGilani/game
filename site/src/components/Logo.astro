---
// The AGENCY mark, as on the app's menu bar: a blue squircle with an "A" whose crossbar is a gaze point.
// Decorative; the name is always written next to it.
---

<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="agency-mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4f8bff"></stop>
      <stop offset="1" stop-color="#1d4fd8"></stop>
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="46" height="46" rx="13" fill="url(#agency-mark)"></rect>
  <rect
    x="1.5"
    y="1.5"
    width="45"
    height="45"
    rx="12.5"
    fill="none"
    stroke="#ffffff"
    stroke-opacity="0.25"
  ></rect>
  <path
    d="M12 36 L24 12 L36 36"
    fill="none"
    stroke="#ffffff"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="24" cy="29" r="3.6" fill="#ffd166"></circle>
</svg>
