  <defs>
    <linearGradient id="agency-mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6c3ce1"></stop>
      <stop offset="1" stop-color="#ff5fa2"></stop>
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="46" height="46" rx="15" fill="url(#agency-mark)"></rect>
  <path
    d="M12 36 L24 12 L36 36"
    fill="none"
    stroke="#ffffff"
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="24" cy="29" r="4" fill="#ffc83d"></circle>
</svg>
