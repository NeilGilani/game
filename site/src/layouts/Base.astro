---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import shareSrc from "../assets/screenshots/home.png";
import { RELEASES_URL, SOURCE_URL } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Which page this is, for aria-current in the navigation. */
  current?: "home" | "download" | "setup" | "accessibility" | "privacy" | "credits";
}

const { title, description, current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = base;
const link = (path: string) => `${base}${path}`;
// Sections of the home page, in the header on wide screens and in the menu on narrow ones.
const sections = [
  { href: `${home}#how`, label: "How it works" },
  { href: `${home}#who`, label: "Who it's for" },
  { href: `${home}#safety`, label: "Safety" },
  { href: `${home}#story`, label: "Our story" },
  { href: `${home}#faq`, label: "FAQ" },
];
const headerSections = sections.filter((s) => s.label !== "Our story");
// The canonical address comes from SITE_URL (astro.config.mjs), never from a hard-coded host name.
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: shareSrc, width: 1200, format: "png" });
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link("favicon.svg")} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fffaf2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15112a" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta
      property="og:image:alt"
      content="AGENCY's Home screen: twelve big app tiles you choose by looking at them."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <!--
      The page talks to nothing but itself and GitHub (to find the latest release). No trackers, no analytics,
      no cookies, no third-party fonts.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    <script is:inline>
      // Apply the saved theme before the first paint, so the page never flashes the wrong colours.
      // The choice stays in this browser (localStorage). It is never sent anywhere.
      document.documentElement.classList.add("js");
      try {
        const saved = localStorage.getItem("agency-site.theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link btn btn-sun" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={home} aria-current={current === "home" ? "page" : undefined}>
          <Logo />
          <span>AGENCY</span>
        </a>
        <nav class="site-nav" aria-label="Sections">
          <ul>
            {headerSections.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <ul class="header-cta" aria-label="Get AGENCY">
          <li>
            <a class="btn btn-primary" href={link("app/")}>
              Try in browser
            </a>
          </li>
          <li>
            <a
              class="btn btn-sun"
              href={link("download/")}
              aria-current={current === "download" ? "page" : undefined}
            >
              Download
            </a>
          </li>
        </ul>
        <details class="menu">
          <summary class="btn">
            <Icon name="menu" />
            <span class="when-closed">Menu</span>
            <span class="when-open">Close menu</span>
          </summary>
          <nav aria-label="Sections (menu)">
            <ul>
              <li>
                <a class="btn btn-primary" href={link("app/")}>
                  Try it in your browser
                </a>
              </li>
              <li>
                <a class="btn btn-sun" href={link("download/")}>
                  Download for Mac
                </a>
              </li>
              {sections.map((s) => (
                <li>
                  <a class="btn" href={s.href}>
                    {s.label}
                  </a>
                </li>
              ))}
              <li>
                <a class="btn" href={link("setup/")}>
                  Setup guide
                </a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href={home}>
              <Logo />
              <span>AGENCY</span>
            </a>
            <p>
              An eye-controlled computer for people who can only move their eyes. Free, and built in the open.
              1st place, UCSC AI Hackathon, Cloud AI track.
            </p>
          </div>
          <div class="footer-cols">
            <nav aria-label="Get AGENCY">
              <h2>Get AGENCY</h2>
              <ul>
                <li>
                  <a class="target-link" href={link("app/")}>
                    Try it in your browser
                  </a>
                </li>
                <li>
                  <a class="target-link" href={link("download/")}>
                    Download for Mac
                  </a>
                </li>
                <li>
                  <a class="target-link" href={link("setup/")}>
                    Setup guide
                  </a>
                </li>
                <li>
                  <a class="target-link" href={RELEASES_URL}>
                    All releases on GitHub
                  </a>
                </li>
              </ul>
            </nav>
            <nav aria-label="About this site">
              <h2>About</h2>
              <ul>
                <li>
                  <a class="target-link" href={link("accessibility/")}>
                    Accessibility
                  </a>
                </li>
                <li>
                  <a class="target-link" href={link("privacy/")}>
                    Privacy
                  </a>
                </li>
                <li>
                  <a class="target-link" href={link("credits/")}>
                    Credits and photos
                  </a>
                </li>
                <li>
                  <a class="target-link" href={SOURCE_URL}>
                    Source code on GitHub
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        </div>
        <div class="footer-bottom">
          <p class="fine">
            AGENCY is not a medical device and Lifeline is not an emergency service. Out of the box, shops,
            phones and messages are practice versions until someone deliberately sets up real ones. The people
            in our photos are not AGENCY users; the photos are freely licensed (see{" "}
            <a href={link("credits/#photos")}>credits</a>). This site has no trackers, no analytics and no
            cookies.
          </p>
          <button class="btn theme-toggle" type="button" data-theme-toggle hidden>
            <Icon name="moon" />
            <span data-theme-label>Dark</span>
          </button>
        </div>
      </div>
    </footer>

    <script>
      import { initTheme } from "../scripts/theme";
      import { initReveal } from "../scripts/reveal";
      initTheme();
      initReveal();
    </script>
  </body>
</html>
