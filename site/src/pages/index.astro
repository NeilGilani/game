---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import Icon from "../components/Icon.astro";
import NextSection from "../components/NextSection.astro";
import posterSrc from "../assets/screenshots/approval-dark.png";
import {
  CONTACT_EMAIL,
  DEMO_CAPTIONS,
  DEMO_VIDEO,
  ISSUES_URL,
  RELEASES_REPO,
  RELEASES_URL,
  REQUIREMENTS,
  SOURCE_URL,
  STATUS_LABEL,
  STATUS_REVIEWED,
  type Status,
} from "../data/site";

const base = import.meta.env.BASE_URL;
const contactHref = CONTACT_EMAIL
  ? `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("AGENCY OS on my computer")}`
  : `${ISSUES_URL}?q=label%3Aplatforms`;
const contactLabel = CONTACT_EMAIL ? "Email us" : "Tell us on GitHub";
const poster = await getImage({ src: posterSrc, width: 1280, format: "webp" });

/** Facts with their sources. Nothing here is an estimate of ours. */
const stats = [
  {
    value: "33,000",
    label: "Americans live with ALS, by the CDC's estimate",
    source: "CDC",
  },
  {
    value: "80 to 95%",
    label: "of people with ALS lose the ability to rely on speech",
    source: "Beukelman et al., 2011",
  },
  {
    value: "$9,646",
    label: "is what Medicare pays for one speech-generating device",
    source: "CMS 2026 fee schedule",
  },
  {
    value: "3×",
    label: "as likely to suffer a preventable harm in hospital, for patients who can't communicate",
    source: "Bartlett et al., CMAJ 2008",
    href: "https://pmc.ncbi.nlm.nih.gov/articles/PMC2396356",
  },
];

const steps = [
  {
    icon: "eye" as const,
    tone: "teal",
    title: "Look",
    body: "Point with your eyes. Hold your look on a button and it fills, then selects. A blink or a quick glance away doesn't break the hold.",
  },
  {
    icon: "hand" as const,
    tone: "blue",
    title: "Approve",
    body: "Gemini plans the task and carries it out. Before it pays, sends, signs or calls, it shows you exactly what will happen and waits for your look.",
  },
  {
    icon: "check" as const,
    tone: "violet",
    title: "Done, and proven",
    body: "AGENCY checks every step by reading the screen back, then tells you plainly what happened, or what went wrong and what it will try next.",
  },
];

interface Tile {
  id: string;
  title: string;
  status: Status;
  statusNote?: string;
}
const tiles: Record<string, Tile> = {
  agent: {
    id: "agent",
    title: "A Gemini agent that asks first",
    status: "prototype",
    statusNote: "Uses practice (sandbox) stores by default. Real services only after someone sets them up.",
  },
  eyes: { id: "eyes", title: "Eye control with just a webcam", status: "prototype" },
  cloud: {
    id: "cloud",
    title: "Cloud AI that reads the network",
    status: "prototype",
    statusNote: "When Synapse-Mesh isn't running, AGENCY's built-in stand-in router chooses the mode.",
  },
  lifeline: {
    id: "lifeline",
    title: "Lifeline: help, one look away",
    status: "prototype",
    statusNote: "Contacts are simulated phones until someone sets up real ones.",
  },
  talk: { id: "talk", title: "Talk, out loud", status: "prototype" },
  home: { id: "home", title: "A calm Home that knows your usuals", status: "prototype" },
};

const modes = [
  { name: "Ultra-Fusion", net: "Good network", does: "Gemini with full thinking", level: 4 },
  { name: "Lean-Fusion", net: "Congested", does: "Gemini with light thinking", level: 2 },
  { name: "Critical-Fusion", net: "Critical", does: "Built-in plans, at once", level: 1 },
  { name: "Safe-Mode", net: "Offline", does: "Built-in plans; Lifeline retries when back", level: 0 },
];

type Mark = "yes" | "no";
const compareCols = [
  "Control with your eyes",
  "No special hardware",
  "An AI agent finishes the task",
  "Approve with a look",
];
const compare: { name: string; us?: boolean; cells: [Mark, string][] }[] = [
  {
    name: "AGENCY",
    us: true,
    cells: [
      ["yes", "Eye cursor or eye gaze"],
      ["yes", "Just a webcam"],
      ["yes", "Gemini plans and acts"],
      ["yes", "Your OK, for that exact action"],
    ],
  },
  {
    name: "Tobii Dynavox",
    cells: [
      ["yes", "Accurate"],
      ["no", "$10,000+ hardware"],
      ["no", "You click every step"],
      ["no", "No agent"],
    ],
  },
  {
    name: "Apple Eye Tracking",
    cells: [
      ["yes", "A cursor"],
      ["yes", "Device camera"],
      ["no", "Cursor only"],
      ["no", "No agent"],
    ],
  },
  {
    name: "Microsoft Eye Control",
    cells: [
      ["yes", "A cursor"],
      ["no", "Needs a Tobii tracker"],
      ["no", "Cursor only"],
      ["no", "No agent"],
    ],
  },
  {
    name: "OpenAI Operator, Gemini agents",
    cells: [
      ["no", "Built for typing or talking"],
      ["yes", "Any computer"],
      ["yes", "Yes"],
      ["no", "Built for typing or talking"],
    ],
  },
  {
    name: "Google Look to Speak",
    cells: [
      ["yes", "Picks phrases"],
      ["yes", "Phone camera"],
      ["no", "Talking only"],
      ["no", "No agent"],
    ],
  },
];

const promises = [
  {
    icon: "camera" as const,
    title: "Your camera stays on your computer",
    body: "Video is processed on the device and thrown away. It's never stored and never sent. The cloud gets the task, never your face.",
  },
  {
    icon: "hand" as const,
    title: "Nothing important without you",
    body: "Pay, send, sign, call, delete and share wait for your approval of that exact action. Change anything and it asks again. Stop works from every screen.",
  },
  {
    icon: "wallet" as const,
    title: "Spending limits",
    body: "$50 a purchase and $100 a day by default, on top of your approval.",
  },
  {
    icon: "sandbox" as const,
    title: "Practice first",
    body: "Out of the box, stores are sandboxes and phones are simulated. Nobody real is contacted and nothing is bought until someone sets up the real thing.",
  },
  {
    icon: "lock" as const,
    title: "No passwords in the AI's hands",
    body: "AGENCY never types, reads or keeps passwords, two-factor codes or card numbers.",
  },
  {
    icon: "doc" as const,
    title: "Pages can't give orders",
    body: "Text on web pages, emails and documents is information, never instructions. If a page tries to steer the agent, it stops and shows you.",
  },
  {
    icon: "heart" as const,
    title: "Not a medical device",
    body: "AGENCY isn't a medical device or a ventilator alarm and hasn't been clinically tested. Keep your existing alarms and care routines.",
  },
  {
    icon: "bell" as const,
    title: "Not an emergency service",
    body: "Lifeline contacts the people you choose until one says they're coming. It never calls 911 by itself.",
  },
];

const faqs: { q: string; a: string[] }[] = [
  {
    q: "Do I need a special eye tracker?",
    a: [
      "No. AGENCY works with an ordinary webcam, like the one in a MacBook. Eye cursor works the moment the camera is on, with no setup. Eye gaze adds a 5-second eye scan: a light glides across the screen, then you look at three dots.",
      "Webcam eye tracking is approximate, so AGENCY uses big, well-spaced buttons, a cursor that glides instead of jittering, and holds that survive a blink. Dedicated eye trackers aren't supported yet.",
    ],
  },
  {
    q: "What if eye tracking doesn't work well for me?",
    a: [
      "AGENCY also works with a single switch (one button or a long blink, with choices highlighted in turn), with a head pointer, and with a mouse or keyboard for a helper.",
    ],
  },
  {
    q: "Will it do things without asking me?",
    a: [
      "Not anything that matters. Paying, sending, signing, calling, deleting and sharing your details all need your approval of the exact action, and spending is capped at $50 a purchase and $100 a day by default. Stop halts everything at once, from any screen.",
    ],
  },
  {
    q: "What happens when the internet is bad?",
    a: [
      "Every AI request goes through Synapse-Mesh, whose Cisco sentinel measures the network first. On a good network it runs Ultra-Fusion: Gemini with full thinking. When it's congested, Lean-Fusion: lighter thinking. When it's critical, Critical-Fusion: AGENCY's built-in plans, at once. Offline, Safe-Mode: built-in plans, and Lifeline retries its messages when the connection is back.",
    ],
  },
  {
    q: "Does Lifeline call 911?",
    a: [
      "No. AGENCY never contacts emergency services by itself. Lifeline contacts the people you choose, and keeps contacting them until one of them says they're coming. They can call for an ambulance. Lifeline is not an emergency service and not a medical alarm, and it doesn't replace your ventilator's alarms.",
    ],
  },
  {
    q: "Is my camera video uploaded anywhere?",
    a: [
      "No. Camera frames are processed on your computer and thrown away. They are never stored and never sent anywhere, including to the AI.",
    ],
  },
  {
    q: "What does the AI see?",
    a: [
      "Only what a task you started needs: the text of your request and, when the agent has to look, the app it's working in. Screenshots aren't kept by default. Text on web pages, emails and documents is treated as information, never as instructions.",
      "AI tasks need a Google Gemini API key, and Google's terms apply to what's sent. Without a key, AGENCY runs its built-in plans only.",
    ],
  },
  {
    q: "Does it cost anything?",
    a: [
      "Downloading AGENCY OS from this page costs nothing, and there's nothing to buy here. If you use AI tasks, Google bills the account whose Gemini API key you use.",
    ],
  },
  {
    q: "Is it a medical device?",
    a: [
      "No. AGENCY OS is not a medical device, a ventilator alarm or an emergency service, and it hasn't been clinically tested. It hasn't yet been evaluated with the people it's built for; that study is the next big piece of work.",
    ],
  },
  {
    q: "Does it work on Windows, iPad or Linux?",
    a: [
      "Not yet. The Mac app relies on macOS accessibility features to work in every app. Tell us what you'd use, and we'll write back if that changes.",
    ],
  },
];
---

<Base
  title="AGENCY OS: run a Mac with just your eyes"
  description="An eye-controlled Mac for people who can only move their eyes. Just a webcam. A Gemini agent that finishes tasks and asks first, cloud AI that adapts to the network, Talk, and Lifeline."
>
  <!-- Hero ------------------------------------------------------------------------------------------- -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-copy">
        <p class="pill">
          <span class="pill-dot" aria-hidden="true"></span>
          UCSC AI Hackathon · Cloud AI track
        </p>
        <h1 id="hero-title">
          Run a Mac with <span class="grad-text">just your eyes.</span>
        </h1>
        <p class="lede">
          An eye-controlled Mac for people who can only move their eyes. Look at what you want, and Gemini
          does it, asking you before anything that matters. All you need is a webcam.
        </p>
        <div class="actions hero-actions">
          <a class="btn btn-primary btn-stack" href={`${base}app/`}>
            Try it in your browser
            <span class="sub">Nothing to install. Camera video stays in your browser.</span>
          </a>
          <a class="btn btn-stack" href="#download">
            Download for Mac
            <span class="sub">macOS 13 or later · Apple silicon or Intel</span>
          </a>
        </div>
        <ul class="proof" aria-label="In short">
          <li>
            <Icon name="camera" /> Just a webcam
          </li>
          <li>
            <Icon name="lock" /> Video never leaves the computer
          </li>
          <li>
            <Icon name="hand" /> Asks before it pays, sends or signs
          </li>
          <li>
            <Icon name="bell" /> Help is three long blinks away
          </li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="float float-a" aria-hidden="true">
          <span class="float-icon tone-teal">
            <Icon name="eye" />
          </span>
          <span>
            <strong>Eye cursor</strong>
            <br />
            No setup
          </span>
        </div>
        <div class="float float-b" aria-hidden="true">
          <span class="float-icon tone-blue">
            <Icon name="sparkles" />
          </span>
          <span>
            <strong>Gemini plans</strong>
            <br />
            You approve
          </span>
        </div>
        <div class="float float-c" aria-hidden="true">
          <span class="float-icon tone-red">
            <Icon name="bell" />
          </span>
          <span>
            <strong>Lifeline</strong>
            <br />
            Three long blinks
          </span>
        </div>
        <Shot name="home" eager frame caption="short" sizes="(min-width: 78rem) 72rem, 94vw" />
      </div>
      <p class="hero-honest">
        Being built in the open. Not a medical device. Shops, phones and messages are practice versions until
        you set up real ones.
      </p>
    </div>
  </section>

  <!-- Why it matters ----------------------------------------------------------------------------------- -->
  <section class="section section-stats" aria-labelledby="why-title" id="why">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Why it matters</p>
        <h2 id="why-title">Losing your voice shouldn't mean losing your say.</h2>
      </div>
      <ul class="stats">
        {stats.map((s, i) => (
          <li class="stat reveal" style={`--i:${i}`}>
            <p class="stat-value grad-text">{s.value}</p>
            <p class="stat-label">{s.label}</p>
            <p class="stat-source">Source: {s.href ? <a href={s.href}>{s.source}</a> : s.source}</p>
          </li>
        ))}
      </ul>
      <p class="stats-after reveal">
        Dedicated eye-gaze systems cost thousands, and you still click every step yourself. AGENCY uses the
        webcam you already have, and an AI agent that finishes the job.
      </p>
    </div>
  </section>

  <!-- Demo video --------------------------------------------------------------------------------------- -->
  <section class="section section-tight" aria-labelledby="demo-title" id="demo">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Demo</p>
        <h2 id="demo-title">See it work in about a minute</h2>
      </div>
      {DEMO_VIDEO ? (
        <figure class="video reveal">
          <div class="video-frame">
            <video controls preload="none" playsinline poster={poster.src} src={`${base}${DEMO_VIDEO}`}>
              {DEMO_CAPTIONS && (
                <track kind="captions" srclang="en" label="English" src={`${base}${DEMO_CAPTIONS}`} default />
              )}
            </video>
          </div>
          <figcaption>
            Recorded from the real AGENCY interface, with captions. It never plays by itself.
          </figcaption>
        </figure>
      ) : (
        <div class="video-slot reveal" role="note" aria-label="Demo video not recorded yet">
          <p class="video-slot-title">The demo video isn't recorded yet.</p>
          <p>Until it exists, this space stays empty rather than showing a mock-up.</p>
        </div>
      )}
    </div>
  </section>

  <!-- How it works ------------------------------------------------------------------------------------- -->
  <section class="section section-alt" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">
          Look. Approve. <span class="grad-text">Done.</span>
        </h2>
        <p class="lede">Three steps, all with your eyes. No hands, no voice, no special hardware.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="card step reveal" style={`--i:${i}`}>
            <span class:list={["app-icon", `tone-${s.tone}`]} aria-hidden="true">
              <Icon name={s.icon} />
            </span>
            <span class="step-num" data-n={`0${i + 1}`} aria-hidden="true"></span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <NextSection href="#features" label="Features" />
    </div>
  </section>

  <!-- Features ----------------------------------------------------------------------------------------- -->
  <section class="section" id="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Features</p>
        <h2 id="features-title">Everything a day needs, a few looks away.</h2>
        <p class="lede">
          Each feature says where it really stands, as of {STATUS_REVIEWED}. “{STATUS_LABEL.prototype}” means
          it runs and is tested in the AGENCY app in our repository today.
        </p>
      </div>

      <div class="bento">
        <!-- Agent -->
        <article class="tile tile-wide tile-agent reveal" id={`feature-${tiles.agent!.id}`}>
          <div class="tile-copy">
            <p class:list={["chip", `chip-${tiles.agent!.status}`]}>
              <Icon name="check" />
              {STATUS_LABEL[tiles.agent!.status]}
            </p>
            <h3>{tiles.agent!.title}</h3>
            <p>
              Say what you want with a few looks. Gemini plans it in 1 to 8 steps and does them in Chrome and
              your apps, through a Chrome bridge, macOS accessibility, and computer use only as a last resort.
              It proves each step by reading the screen back.
            </p>
            <ul class="ticks">
              <li>
                <Icon name="hand" /> Pay, send, sign, call, delete and share wait for your OK of that exact
                action. If anything changes, it asks again.
              </li>
              <li>
                <Icon name="wallet" /> Spending limits: $50 a purchase, $100 a day by default.
              </li>
              <li>
                <Icon name="lock" /> It never handles passwords, two-factor codes or card numbers.
              </li>
            </ul>
            <p class="status-note">{tiles.agent!.statusNote}</p>
          </div>
          <div class="tile-visual">
            <Shot name="approval" frame caption="short" sizes="(min-width: 78rem) 40rem, 92vw" />
          </div>
        </article>

        <!-- Eyes -->
        <article class="tile reveal" id={`feature-${tiles.eyes!.id}`}>
          <p class:list={["chip", `chip-${tiles.eyes!.status}`]}>
            <Icon name="check" />
            {STATUS_LABEL[tiles.eyes!.status]}
          </p>
          <h3>{tiles.eyes!.title}</h3>
          <div class="scan" aria-hidden="true">
            <div class="scan-bar">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="scan-light"></span>
            <span class="scan-dot d1">
              <Icon name="check" />
            </span>
            <span class="scan-dot d2">
              <Icon name="check" />
            </span>
            <span class="scan-dot d3">
              <Icon name="check" />
            </span>
            <span class="scan-label">Eye scan · 5 seconds</span>
          </div>
          <ul class="pair">
            <li>
              <strong>Eye cursor</strong>
              <span>The default. Instant, no setup.</span>
            </li>
            <li>
              <strong>Eye gaze</strong>
              <span>A 5-second eye scan: a light glides, then three check dots.</span>
            </li>
          </ul>
          <p>
            MediaPipe finds your eyes on the device and RealEye's open-source eye-image model reads where you
            look. The cursor glides smoothly, a held button survives a blink or a glance, and when two buttons
            are close, the AI's guess of your likely next one breaks the tie. Never for pay, send or sign.
          </p>
        </article>

        <!-- Cloud -->
        <article class="tile reveal" id={`feature-${tiles.cloud!.id}`} style="--i:1">
          <p class:list={["chip", `chip-${tiles.cloud!.status}`]}>
            <Icon name="check" />
            {STATUS_LABEL[tiles.cloud!.status]}
          </p>
          <h3>{tiles.cloud!.title}</h3>
          <ol class="pipeline" aria-label="How each AI request is routed">
            <li>
              <Icon name="cpu" /> Sifter, on device, picks expert lenses
            </li>
            <li>
              <Icon name="network" /> Cisco sentinel measures the network
            </li>
            <li>
              <Icon name="sparkles" /> Gemini thinks as hard as it allows
            </li>
          </ol>
          <ul class="modes">
            {modes.map((m) => (
              <li class={`mode mode-${m.level}`}>
                <span class="bars" aria-hidden="true">
                  {[1, 2, 3, 4].map((b) => (
                    <span class:list={[b <= m.level && "on"]} />
                  ))}
                </span>
                <span class="mode-name">{m.name}</span>
                <span class="mode-does">
                  <strong>{m.net}.</strong> {m.does}.
                </span>
              </li>
            ))}
          </ul>
          <p>
            Every AI request goes through Ray's Synapse-Mesh first, so a bad signal slows the thinking down
            instead of leaving you stuck.
          </p>
          <p class="status-note">{tiles.cloud!.statusNote}</p>
        </article>

        <!-- Lifeline -->
        <article class="tile tile-lifeline reveal" id={`feature-${tiles.lifeline!.id}`}>
          <p class:list={["chip", `chip-${tiles.lifeline!.status}`]}>
            <Icon name="check" />
            {STATUS_LABEL[tiles.lifeline!.status]}
          </p>
          <h3>{tiles.lifeline!.title}</h3>
          <ol class="timeline">
            <li>
              <strong>Three long blinks</strong> or a look at Help
            </li>
            <li>
              <strong>8 seconds</strong> to cancel
            </li>
            <li>
              <strong>Your people</strong>, one after another, until someone says “I'm on my way”
            </li>
          </ol>
          <Shot name="help-countdown" frame caption="short" sizes="(min-width: 78rem) 36rem, 92vw" />
          <p>It never calls 911 by itself. The people who come can.</p>
          <p class="status-note">{tiles.lifeline!.statusNote}</p>
        </article>

        <!-- Talk -->
        <article class="tile reveal" id={`feature-${tiles.talk!.id}`} style="--i:1">
          <p class:list={["chip", `chip-${tiles.talk!.status}`]}>
            <Icon name="check" />
            {STATUS_LABEL[tiles.talk!.status]}
          </p>
          <h3>{tiles.talk!.title}</h3>
          <p>
            Build a sentence from big word and phrase boards and AGENCY says it out loud, in Apple's Personal
            Voice if you've made one. Listen mode shows what people say in big text, with replies one look
            away.
          </p>
          <Shot name="talk" frame caption="short" sizes="(min-width: 78rem) 36rem, 92vw" />
        </article>

        <!-- Home -->
        <article class="tile tile-wide tile-slim reveal" id={`feature-${tiles.home!.id}`}>
          <div>
            <p class:list={["chip", `chip-${tiles.home!.status}`]}>
              <Icon name="check" />
              {STATUS_LABEL[tiles.home!.status]}
            </p>
            <h3>{tiles.home!.title}</h3>
          </div>
          <div>
            <p>
              Twelve big apps, from Talk and Food to Papers and Lifeline. AGENCY learns what you usually
              choose, like Friday's pad thai, and offers it first with a plain reason: “You chose this 4 of
              the last 5 Fridays”.
            </p>
            <p>You can see, change or erase everything it remembers, and it stays on your computer.</p>
          </div>
        </article>
      </div>
      <NextSection href="#compare" label="Why AGENCY is different" />
    </div>
  </section>

  <!-- Compare ------------------------------------------------------------------------------------------ -->
  <section class="section section-alt" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Why AGENCY is different</p>
        <h2 id="compare-title">Others do one part. AGENCY does the whole job.</h2>
        <p class="lede">
          Eye control, an AI agent that finishes the task, approval with a look, and an emergency signal. With
          just a webcam.
        </p>
      </div>
      <div class="compare reveal">
        <table>
          <caption class="sr-only">How AGENCY compares with other eye-control tools and AI agents</caption>
          <thead>
            <tr>
              <th scope="col">
                <span class="sr-only">Product</span>
              </th>
              {compareCols.map((c) => (
                <th scope="col">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr class:list={[row.us && "is-us"]}>
                <th scope="row">{row.name}</th>
                {row.cells.map(([mark, text], i) => (
                  <td data-col={compareCols[i]}>
                    <span class="cell">
                      <span class:list={["mark", `mark-${mark}`]}>
                        <Icon name={mark === "yes" ? "check" : "x"} />
                        <span class="sr-only">{mark === "yes" ? "Yes:" : "No:"}</span>
                      </span>
                      <span>{text}</span>
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
