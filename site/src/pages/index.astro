                {row.cells.map(([mark, text], i) => (
                  <td data-col={compareCols[i]}>
                    <span class="cell">
                      <span class:list={["mark", `mark-${mark}`]}>
                        <Icon name={mark === "yes" ? "check" : "x"} />
                        <span class="sr-only">{mark === "yes" ? "Yes:" : "No:"}</span>
                      </span>
                      <span>{text}</span>
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare-fine">Based on each product's own public description, October 2026.</p>
      <NextSection href="#start" label="Get started" />
