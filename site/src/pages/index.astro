---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import CtaPair from "../components/CtaPair.astro";
import NextSection from "../components/NextSection.astro";
import posterSrc from "../assets/screenshots/home.png";
import {
  CONTACT_EMAIL,
  DEMO_CAPTIONS,
  DEMO_VIDEO,
  ISSUES_URL,
  SOURCE_URL,
  STATUS_LABEL,
  STATUS_REVIEWED,
  TEAM,
  type Status,
} from "../data/site";

const base = import.meta.env.BASE_URL;
const contactHref = CONTACT_EMAIL
  ? `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("About AGENCY")}`
  : ISSUES_URL;
const contactLabel = CONTACT_EMAIL ? "Email us" : "Talk to us on GitHub";
const poster = await getImage({ src: posterSrc, width: 1280, format: "webp" });

/**
 * How to use AGENCY. Each line was checked against the interface's code (frontend/src): the dwell ring
 * (input/InputLayer.tsx), the eye cursor without calibration (vision/eyeCursor.ts), squint to scroll
 * (input/SquintScroll.tsx), the eye keyboard (components/EyeKeyboard.tsx), Help in the dock on every screen
 * (components/Shell.tsx), and approvals before consequential actions.
 */
const howTo = [
  {
    icon: "target" as const,
    tone: "sun",
    title: "Look and hold",
    body: "Look at a button and keep looking. A ring fills up around the pointer. When it's full, the button is chosen. Look away, and nothing happens.",
  },
  {
    icon: "eye" as const,
    tone: "teal",
    title: "No calibration",
    body: "The eye cursor follows your eyes as soon as the camera is on. There is nothing to set up first.",
  },
  {
    icon: "updown" as const,
    tone: "coral",
    title: "Squint to scroll",
    body: "Squint, then move your head up or down to scroll a page. Open your eyes again to stop.",
  },
  {
    icon: "keyboard" as const,
    tone: "violet",
    title: "Type with your eyes",
    body: "Look at a text box and big keys appear at the bottom of the screen. Look at each letter to type it.",
  },
  {
    icon: "bell" as const,
    tone: "pink",
    title: "Help, one look away",
    body: "Help is on every screen. Look at it, or close your eyes for a second, three times. You then have 8 seconds to cancel.",
  },
  {
    icon: "hand" as const,
    tone: "teal",
    title: "You stay in charge",
    body: "Before AGENCY pays, sends, signs or calls, it shows you exactly what will happen and waits for your OK.",
  },
];

const audiences = [
  {
    photo: "leading-meeting",
    tone: "coral",
    title: "For people who can only move their eyes",
    body: "Living with ALS, locked-in syndrome, a stroke or a high spinal cord injury? If your eyes still move, AGENCY lets you choose, write, talk and ask for help.",
  },
  {
    photo: "home-laptop",
    tone: "sun",
    title: "For families and caregivers",
    body: "Set AGENCY up with a mouse and keyboard in about fifteen minutes, then hand it over. Lifeline contacts need no app and no account.",
  },
  {
    photo: "clinician-laugh",
    tone: "teal",
    title: "For clinicians, therapists and funders",
    body: "Every feature says what works today, what is a practice version, and what hasn't been tested yet. We want to test AGENCY properly, with the people it's for.",
  },
];

interface Feature {
  shot: string;
  tone: string;
  title: string;
  body: string;
  status: Status;
  note?: string;
}
const features: Feature[] = [
  {
    shot: "talk",
    tone: "violet",
    title: "Talk, out loud",
    body: "Build a sentence from big word buttons and AGENCY says it out loud, in your own Personal Voice if you've made one on your Mac. Listen mode shows what people say in big text.",
    status: "prototype",
  },
  {
    shot: "approval",
    tone: "sun",
    title: "An AI helper that asks first",
    body: "Say what you want with a few looks. Google's Gemini plans the steps and does them. Before anything important, it shows you exactly what will happen and waits.",
    status: "prototype",
    note: "Shops and services are practice versions until someone sets up real ones.",
  },
  {
    shot: "help-countdown",
    tone: "coral",
    title: "Lifeline: help when you need it",
    body: "Three long blinks, or a look at Help. After 8 seconds, AGENCY contacts your people one by one until someone says “I'm on my way”. It never calls 911 by itself.",
    status: "prototype",
    note: "Contacts are practice phones until someone sets up real ones.",
  },
  {
    shot: "home",
    tone: "teal",
    title: "A calm Home that knows your usuals",
    body: "Twelve big apps, from Talk and Food to Lifeline. AGENCY learns what you usually choose and offers it first. You can see, change or erase what it remembers.",
    status: "prototype",
  },
];

const promises = [
  {
    icon: "camera" as const,
    tone: "teal",
    title: "Your camera stays on your computer",
    body: "Video is processed on the device and thrown away. It's never stored and never sent.",
  },
  {
    icon: "hand" as const,
    tone: "sun",
    title: "Nothing important without you",
    body: "Pay, send, sign, call, delete and share wait for your OK of that exact action. Stop works from every screen.",
  },
  {
    icon: "wallet" as const,
    tone: "coral",
    title: "Spending limits",
    body: "$50 a purchase and $100 a day by default, on top of your approval.",
  },
  {
    icon: "sandbox" as const,
    tone: "violet",
    title: "Practice first",
    body: "Out of the box, shops are practice stores and phones are simulated. Nobody real is contacted until someone sets that up.",
  },
  {
    icon: "lock" as const,
    tone: "pink",
    title: "No passwords in the AI's hands",
    body: "AGENCY never types, reads or keeps passwords, two-factor codes or card numbers.",
  },
  {
    icon: "doc" as const,
    tone: "teal",
    title: "Pages can't give orders",
    body: "Text on web pages and emails is information, never instructions. If a page tries to steer the AI, it stops and shows you.",
  },
  {
    icon: "heart" as const,
    tone: "coral",
    title: "Not a medical device",
    body: "AGENCY hasn't been clinically tested. Keep your existing alarms and care routines.",
  },
  {
    icon: "bell" as const,
    tone: "sun",
    title: "Not an emergency service",
    body: "Lifeline contacts the people you choose until one says they're coming. It never calls 911 by itself.",
  },
];

/** Facts with their sources. Nothing here is an estimate of ours. */
const stats = [
  { value: "33,000", label: "Americans live with ALS, by the CDC's estimate", source: "CDC" },
  {
    value: "80 to 95%",
    label: "of people with ALS lose the ability to rely on speech",
    source: "Beukelman et al., 2011",
  },
  {
    value: "$9,646",
    label: "is what Medicare pays for one speech-generating device",
    source: "CMS 2026 fee schedule",
  },
  {
    value: "3×",
    label: "as likely to suffer a preventable harm in hospital, for patients who can't communicate",
    source: "Bartlett et al., CMAJ 2008",
    href: "https://pmc.ncbi.nlm.nih.gov/articles/PMC2396356",
  },
];

const modes = [
  { name: "Ultra-Fusion", net: "Good network", does: "Gemini with full thinking", level: 4 },
  { name: "Lean-Fusion", net: "Congested", does: "Gemini with light thinking", level: 2 },
  { name: "Critical-Fusion", net: "Critical", does: "Built-in plans, at once", level: 1 },
  { name: "Safe-Mode", net: "Offline", does: "Built-in plans; Lifeline retries when back", level: 0 },
];

type Mark = "yes" | "no";
const compareCols = [
  "Control with your eyes",
  "No special hardware",
  "An AI agent finishes the task",
  "Approve with a look",
];
const compare: { name: string; us?: boolean; cells: [Mark, string][] }[] = [
  {
    name: "AGENCY",
    us: true,
    cells: [
      ["yes", "Eye cursor or eye gaze"],
      ["yes", "Just a webcam"],
      ["yes", "Gemini plans and acts"],
      ["yes", "Your OK, for that exact action"],
    ],
  },
  {
    name: "Tobii Dynavox",
    cells: [
      ["yes", "Accurate"],
      ["no", "$10,000+ hardware"],
      ["no", "You click every step"],
      ["no", "No agent"],
    ],
  },
  {
    name: "Apple Eye Tracking",
    cells: [
      ["yes", "A cursor"],
      ["yes", "Device camera"],
      ["no", "Cursor only"],
      ["no", "No agent"],
    ],
  },
  {
    name: "Microsoft Eye Control",
    cells: [
      ["yes", "A cursor"],
      ["no", "Needs a Tobii tracker"],
      ["no", "Cursor only"],
      ["no", "No agent"],
    ],
  },
  {
    name: "OpenAI Operator, Gemini agents",
    cells: [
      ["no", "Built for typing or talking"],
      ["yes", "Any computer"],
      ["yes", "Yes"],
      ["no", "Built for typing or talking"],
    ],
  },
  {
    name: "Google Look to Speak",
    cells: [
      ["yes", "Picks phrases"],
      ["yes", "Phone camera"],
      ["no", "Talking only"],
      ["no", "No agent"],
    ],
  },
];

const faqs: { q: string; a: string[] }[] = [
  {
    q: "Do I need a special eye tracker?",
    a: [
      "No. AGENCY works with an ordinary webcam, like the one in a MacBook. The eye cursor works as soon as the camera is on, with no setup. Eye gaze adds a 5-second eye scan: a light glides across the screen, then you look at three dots.",
      "Webcam eye tracking is approximate, so AGENCY uses big, well-spaced buttons, a pointer that glides instead of jittering, and holds that survive a blink. Dedicated eye trackers aren't supported yet.",
    ],
  },
  {
    q: "Can I try it before installing anything?",
    a: [
      "Yes. “Try it in your browser” opens the real AGENCY interface in your web browser, with practice services. It needs a webcam. Camera video is processed in your browser and never sent anywhere.",
    ],
  },
  {
    q: "What if eye tracking doesn't work well for me?",
    a: [
      "AGENCY also works with a single switch (one button or a long blink, with choices highlighted in turn), with a head pointer, and with a mouse or keyboard for a helper.",
    ],
  },
  {
    q: "Will it do things without asking me?",
    a: [
      "Not anything that matters. Paying, sending, signing, calling, deleting and sharing your details all need your approval of the exact action, and spending is capped at $50 a purchase and $100 a day by default. Stop halts everything at once, from any screen.",
    ],
  },
  {
    q: "Does Lifeline call 911?",
    a: [
      "No. AGENCY never contacts emergency services by itself. Lifeline contacts the people you choose, and keeps contacting them until one of them says they're coming. They can call for an ambulance. Lifeline is not an emergency service and not a medical alarm, and it doesn't replace your ventilator's alarms.",
    ],
  },
  {
    q: "Is my camera video uploaded anywhere?",
    a: [
      "No. Camera frames are processed on your computer and thrown away. They are never stored and never sent anywhere, including to the AI.",
    ],
  },
  {
    q: "What does the AI see?",
    a: [
      "Only what a task you started needs: the text of your request and, when the agent has to look, the app it's working in. Screenshots aren't kept by default. Text on web pages, emails and documents is treated as information, never as instructions.",
      "AI tasks need a Google Gemini API key, and Google's terms apply to what's sent. Without a key, AGENCY runs its built-in plans only.",
    ],
  },
  {
    q: "What happens when the internet is bad?",
    a: [
      "Every AI request goes through Synapse-Mesh, whose Cisco sentinel measures the network first. A good network gets Gemini with full thinking, a congested one gets lighter thinking, and a critical one gets AGENCY's built-in plans at once. Offline, Lifeline keeps its messages and retries when the connection is back.",
    ],
  },
  {
    q: "Does it cost anything?",
    a: [
      "Downloading AGENCY costs nothing, and there's nothing to buy here. If you use AI tasks, Google bills the account whose Gemini API key you use.",
    ],
  },
  {
    q: "Is it a medical device?",
    a: [
      "No. AGENCY is not a medical device, a ventilator alarm or an emergency service, and it hasn't been clinically tested. It hasn't yet been evaluated with the people it's built for; that study is the next big piece of work.",
    ],
  },
  {
    q: "Does it work on Windows, iPad or Linux?",
    a: [
      "The Mac app needs a Mac for now, because it relies on macOS accessibility features to work in every app. The browser version runs in a desktop web browser. Tell us what you'd use, and we'll write back if that changes.",
    ],
  },
];
---

<Base
  title="AGENCY: use a computer with just your eyes"
  description="A free, eye-controlled computer for people who can only move their eyes, and the people who care for them. Just a webcam. Try it in your browser or download it for Mac."
>
  <!-- Hero ------------------------------------------------------------------------------------------- -->
  <section class="hero" aria-labelledby="hero-title">
    <span class="blob blob-1" aria-hidden="true"></span>
    <span class="blob blob-2" aria-hidden="true"></span>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="award">
          <span class="award-icon" aria-hidden="true">
            <Icon name="trophy" />
          </span>
          1st place, UCSC AI Hackathon, Cloud AI track
        </p>
        <h1 id="hero-title">
          Use a computer with <span class="hl">just your eyes.</span>
        </h1>
        <p class="lede hero-lede">
          AGENCY is a free, eye-controlled computer for people who can only move their eyes, and the people
          who care for them. All you need is a webcam.
        </p>
        <CtaPair class="hero-cta" />
        <ul class="proof" aria-label="In short">
          <li class="tone-teal">
            <Icon name="camera" /> Just a webcam
          </li>
          <li class="tone-violet">
            <Icon name="lock" /> Video stays on your computer
          </li>
          <li class="tone-sun">
            <Icon name="hand" /> Asks before anything important
          </li>
          <li class="tone-coral">
            <Icon name="bell" /> Help is one look away
          </li>
        </ul>
      </div>

      <div class="hero-visual">
        <span class="ring-deco" aria-hidden="true"></span>
        <Photo id="care-hands" eager class="hero-photo" sizes="(min-width: 1100px) 600px, 92vw" />
        <div class="hero-shot">
          <Shot name="home" frame caption="short" sizes="(min-width: 1100px) 380px, 70vw" />
        </div>
        <div class="float float-dwell" aria-hidden="true">
          <span class="dwell-ring">
            <span></span>
          </span>
          <span>
            <strong>Look and hold</strong>
            <br />
            to choose
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Story ------------------------------------------------------------------------------------------- -->
  <section class="section band-sun story" id="story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="reveal">
        <p class="eyebrow">Our story</p>
        <h2 id="story-title">It started with one grandmother.</h2>
        <p class="story-big">We built AGENCY for one person first: a team member's grandmother.</p>
        <p>
          Then we took it to the UCSC AI Hackathon, where it won 1st place in the Cloud AI track. Now we're
          turning AGENCY into a nonprofit, so it can reach more people who can only move their eyes, and the
          families who look after them.
        </p>
        <p>
          It's built in the open. The <a href={SOURCE_URL}>source code is on GitHub</a> for anyone to read.
        </p>
      </div>
      <div class="story-cards">
        <div class="trophy-card reveal" style="--i:1">
          <span class="trophy-badge" aria-hidden="true">
            <Icon name="trophy" />
          </span>
          <p class="trophy-big">1st place</p>
          <p class="trophy-small">
            UCSC AI Hackathon
            <br />
            Cloud AI track
          </p>
        </div>
        <div class="card team-card reveal" style="--i:2">
          <h3>The team</h3>
          <ul class="team">
            {TEAM.map((m, i) => (
              <li>
                <span
                  class:list={["avatar", `tone-${["coral", "teal", "violet"][i % 3]}`]}
                  aria-hidden="true"
                >
                  {m.initials}
                </span>
                <span>{m.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <div class="wrap">
      <NextSection href="#how" label="How to use it" />
    </div>
  </section>

  <!-- How to use it ---------------------------------------------------------------------------------- -->
  <section class="section" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How to use it</p>
        <h2 id="how-title">
          Everything works <span class="hl hl-teal">with your eyes.</span>
        </h2>
        <p class="lede">No hands, no voice and no special hardware. Here's all there is to learn.</p>
      </div>
      <ol class="howto">
        {howTo.map((s, i) => (
          <li class:list={["howto-card", "reveal", `tone-${s.tone}`]} style={`--i:${i % 3}`}>
            <span class="howto-num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="badge" aria-hidden="true">
              <Icon name={s.icon} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="demo" id="demo">
        <div class="demo-copy reveal">
          <h3 class="demo-title">See it work in about a minute</h3>
          <p>
            A recording of the real AGENCY interface, with captions. It never plays by itself. Or try it now:
          </p>
          <a class="btn btn-primary" href={`${base}app/`}>
            <Icon name="browser" /> Try it in your browser
          </a>
        </div>
        {DEMO_VIDEO ? (
          <figure class="video reveal">
            <div class="video-frame">
              <video controls preload="none" playsinline poster={poster.src} src={`${base}${DEMO_VIDEO}`}>
                {DEMO_CAPTIONS && (
                  <track
                    kind="captions"
                    srclang="en"
                    label="English"
                    src={`${base}${DEMO_CAPTIONS}`}
                    default
                  />
                )}
              </video>
            </div>
          </figure>
        ) : (
          <div class="video-slot reveal" role="note" aria-label="Demo video not recorded yet">
            <p>The demo video isn't recorded yet. Until it exists, this space stays empty.</p>
          </div>
        )}
      </div>
      <NextSection href="#who" label="Who it's for" />
    </div>
  </section>

  <!-- Who it's for ----------------------------------------------------------------------------------- -->
  <section class="section band-tint" id="who" aria-labelledby="who-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Who it's for</p>
        <h2 id="who-title">For people who can only move their eyes, and everyone around them.</h2>
      </div>
      <ul class="audiences">
        {audiences.map((a, i) => (
          <li class:list={["audience", "reveal", `tone-${a.tone}`]} style={`--i:${i}`}>
            <Photo id={a.photo} class="audience-photo" sizes="(min-width: 1100px) 400px, 92vw" />
            <div class="audience-copy">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="center photo-note">
        Photos are of people who aren't AGENCY users. They're here to show who we build for.
      </p>
      <NextSection href="#features" label="What AGENCY can do" />
    </div>
  </section>

  <!-- Features --------------------------------------------------------------------------------------- -->
  <section class="section" id="features" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">What it can do</p>
        <h2 id="features-title">
          Everything a day needs, <span class="hl hl-pink">a few looks away.</span>
        </h2>
        <p class="lede">
          These are real screenshots of AGENCY with practice data. Each feature says where it really stands,
          as of {STATUS_REVIEWED}.
        </p>
      </div>
      <div class="features">
        {features.map((f, i) => (
          <article class:list={["feature", "reveal", `tone-${f.tone}`]} style={`--i:${i % 2}`}>
            <div class="feature-copy">
              <p class:list={["chip", `chip-${f.status}`]}>
                <Icon name="check" />
                {STATUS_LABEL[f.status]}
              </p>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
              {f.note && <p class="feature-note">{f.note}</p>}
            </div>
            <div class="feature-shot">
              <Shot name={f.shot} frame caption="short" sizes="(min-width: 1100px) 560px, 92vw" />
            </div>
          </article>
        ))}
      </div>
      <NextSection href="#safety" label="Safety and privacy" />
    </div>
  </section>

  <!-- Safety ----------------------------------------------------------------------------------------- -->
  <section class="section band-teal" id="safety" aria-labelledby="safety-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Safety and privacy</p>
        <h2 id="safety-title">You stay in control. Always.</h2>
        <p class="lede">
          Your video never leaves your computer by default, and nothing important happens without your OK.
        </p>
      </div>
      <ul class="promises">
        {promises.map((p, i) => (
          <li class:list={["promise", "reveal", `tone-${p.tone}`]} style={`--i:${i % 4}`}>
            <span class="badge" aria-hidden="true">
              <Icon name={p.icon} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
      <p class="center reveal">
        Read the full <a href={`${base}privacy/`}>privacy policy</a>, and how Lifeline is designed and tested
        in <a href={`${SOURCE_URL}/blob/main/LIFELINE.md`}>LIFELINE.md</a>.
      </p>
      <NextSection href="#why" label="Why it matters" />
    </div>
  </section>

  <!-- Why it matters --------------------------------------------------------------------------------- -->
  <section class="section" id="why" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Why it matters</p>
        <h2 id="why-title">Losing your voice shouldn't mean losing your say.</h2>
      </div>
      <ul class="stats">
        {stats.map((s, i) => (
          <li
            class:list={["stat", "reveal", `tone-${["coral", "teal", "violet", "sun"][i]}`]}
            style={`--i:${i}`}
          >
            <p class="stat-value">{s.value}</p>
            <p class="stat-label">{s.label}</p>
            <p class="stat-source">Source: {s.href ? <a href={s.href}>{s.source}</a> : s.source}</p>
          </li>
        ))}
      </ul>
      <p class="center stats-after reveal">
        Dedicated eye-gaze systems cost thousands, and you still click every step yourself. AGENCY uses the
        webcam you already have, and an AI helper that finishes the job.
      </p>
      <NextSection href="#tech" label="Under the hood" />
    </div>
  </section>

  <!-- Under the hood --------------------------------------------------------------------------------- -->
  <section class="section band-deep" id="tech" aria-labelledby="tech-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Under the hood</p>
        <h2 id="tech-title">Gemini, Synapse-Mesh and Cisco, working together.</h2>
        <p class="lede">For the technically curious: how AGENCY thinks, and how it reads your eyes.</p>
      </div>
      <div class="tech-grid">
        <article class="tech-card reveal">
          <h3>Cloud AI that adapts to your connection</h3>
          <ol class="pipeline" aria-label="How each AI request is routed">
            <li>
              <Icon name="cpu" /> Synapse-Mesh's Sifter, on the device, picks expert lenses
            </li>
            <li>
              <Icon name="network" /> Its Cisco sentinel measures the network
            </li>
            <li>
              <Icon name="sparkles" /> Google's Gemini thinks as hard as the network allows
            </li>
          </ol>
          <ul class="modes">
            {modes.map((m) => (
              <li class={`mode mode-${m.level}`}>
                <span class="bars" aria-hidden="true">
                  {[1, 2, 3, 4].map((b) => (
                    <span class:list={[b <= m.level && "on"]} />
                  ))}
                </span>
                <span class="mode-name">{m.name}</span>
                <span class="mode-does">
                  <strong>{m.net}.</strong> {m.does}.
                </span>
              </li>
            ))}
          </ul>
          <p class="tech-note">
            Built on Ray's Synapse-Mesh. When it isn't running, AGENCY's built-in stand-in router picks the
            mode.
          </p>
        </article>
        <article class="tech-card reveal" style="--i:1">
          <h3>Eye tracking with an ordinary webcam</h3>
          <ul class="pair">
            <li>
              <strong>Eye cursor</strong>
              <span>The default. Instant, with no calibration.</span>
            </li>
            <li>
              <strong>Eye gaze</strong>
              <span>Adds a 5-second eye scan: a light glides, then you look at three dots.</span>
            </li>
          </ul>
          <p>
            MediaPipe finds your eyes on the device, and RealEye's open-source eye-image model reads where you
            look. The pointer glides smoothly, and a held button survives a blink or a quick glance away.
          </p>
          <p>
            When two buttons are close, the AI's guess of your likely next choice breaks the tie. Never for
            pay, send or sign.
          </p>
        </article>
      </div>

      <h3 class="compare-title reveal">How AGENCY compares</h3>
      <div class="compare reveal">
        <table>
          <caption class="sr-only">How AGENCY compares with other eye-control tools and AI agents</caption>
          <thead>
            <tr>
              <th scope="col">
