---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Frame from "../components/Frame.astro";
import CtaPair from "../components/CtaPair.astro";
import DwellDemo from "../components/DwellDemo.astro";
import NextSection from "../components/NextSection.astro";
import posterSrc from "../assets/frames/talk-dwell.jpg";
import { CONTACT_EMAIL, DEMO_CAPTIONS, DEMO_VIDEO, ISSUES_URL, SOURCE_URL, TEAM } from "../data/site";

const base = import.meta.env.BASE_URL;
const contactHref = CONTACT_EMAIL
  ? `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("About AGENCY")}`
  : ISSUES_URL;
const contactLabel = CONTACT_EMAIL ? "Email us" : "Ask us on GitHub";
const poster = await getImage({ src: posterSrc, width: 1280, format: "webp", quality: 70 });

/** Places in the demo recording, matching its captions (public/demo/agency-demo.vtt). */
const chapters = [
  { at: 6.5, time: "0:06", label: "Order lunch by looking" },
  { at: 36.3, time: "0:36", label: "Say a sentence out loud" },
  { at: 52.2, time: "0:52", label: "Ask for help" },
];

/**
 * How to use AGENCY. Each line was checked against the interface's code (frontend/src): the dwell ring
 * (input/InputLayer.tsx), the eye cursor without calibration (vision/eyeCursor.ts), squint to scroll
 * (input/SquintScroll.tsx), the eye keyboard (components/EyeKeyboard.tsx), and Help in the dock on every screen
 * (components/Shell.tsx).
 */
const howTo = [
  {
    title: "Look and hold",
    body: "Look at a button and keep looking. A ring fills up. When it's full, the button is chosen. Look away, and nothing happens.",
  },
  {
    title: "No calibration",
    body: "The eye cursor follows your eyes as soon as the camera is on. There is nothing to set up first.",
  },
  {
    title: "Type with your eyes",
    body: "Look at a text box and big keys appear at the bottom of the screen. Look at each letter to type it.",
  },
  {
    title: "Squint to scroll",
    body: "Squint, then move your head up or down to scroll a page. Open your eyes again to stop.",
  },
  {
    title: "Help is one look away",
    body: "Help is on every screen. Look at it, or close your eyes for a second, three times. You then have 8 seconds to cancel.",
  },
];

const audiences = [
  {
    photo: "leading-meeting",
    title: "People who can only move their eyes",
    body: "Living with ALS, locked-in syndrome, a stroke or a high spinal cord injury? If your eyes still move, AGENCY lets you choose, write, talk and ask for help.",
  },
  {
    photo: "care-hands",
    title: "Families and caregivers",
    body: "Set AGENCY up with a mouse and keyboard in about fifteen minutes, then hand it over. Lifeline contacts need no app and no account.",
  },
  {
    photo: "clinician-laugh",
    title: "Clinicians, therapists and funders",
    body: "Every feature says what works today and what is still a practice version. We want to test AGENCY properly, with the people it's for.",
  },
];

const promises = [
  {
    title: "Spending limits",
    body: "$50 a purchase and $100 a day by default, on top of your OK.",
  },
  {
    title: "Practice first",
    body: "Out of the box, shops are practice stores and phones are simulated. Nobody real is contacted until someone sets that up.",
  },
  {
    title: "No passwords in the AI's hands",
    body: "AGENCY never types, reads or keeps passwords, two-factor codes or card numbers.",
  },
  {
    title: "Pages can't give orders",
    body: "Text on web pages and in emails is information, never instructions. If a page tries to steer the AI, it stops and shows you.",
  },
  {
    title: "Not a medical device",
    body: "AGENCY hasn't been clinically tested. Keep your existing alarms and care routines.",
  },
  {
    title: "Not an emergency service",
    body: "Lifeline contacts the people you choose until one says they're coming. It never calls 911 by itself.",
  },
];

const faqs: { q: string; a: string[] }[] = [
  {
    q: "Do I need a special eye tracker?",
    a: [
      "No. AGENCY works with an ordinary webcam, like the one in a MacBook. The eye cursor works as soon as the camera is on, with no setup. Eye gaze adds a 5-second eye scan: a light glides across the screen, then you look at three dots.",
      "Webcam eye tracking is approximate, so AGENCY uses big, well-spaced buttons, a pointer that glides instead of jittering, and holds that survive a blink. Dedicated eye trackers aren't supported yet.",
    ],
  },
  {
    q: "Can I try it before installing anything?",
    a: [
      "Yes. “Try it in your browser” opens the real AGENCY interface in your web browser, with practice services. It needs a webcam. Camera video is processed in your browser and never sent anywhere.",
    ],
  },
  {
    q: "What if eye tracking doesn't work well for me?",
    a: [
      "AGENCY also works with a single switch (one button or a long blink, with choices highlighted in turn), with a head pointer, and with a mouse or keyboard for a helper.",
    ],
  },
  {
    q: "Will it do things without asking me?",
    a: [
      "Not anything that matters. Paying, sending, signing, calling, deleting and sharing your details all need your approval of the exact action, and spending is capped at $50 a purchase and $100 a day by default. Stop halts everything at once, from any screen.",
    ],
  },
  {
    q: "Does Lifeline call 911?",
    a: [
      "No. AGENCY never contacts emergency services by itself. Lifeline contacts the people you choose, and keeps contacting them until one of them says they're coming. They can call for an ambulance. Lifeline is not an emergency service and not a medical alarm, and it doesn't replace your ventilator's alarms.",
    ],
  },
  {
    q: "Does it cost anything?",
    a: [
      "Downloading AGENCY costs nothing, and there's nothing to buy here. If you use AI tasks, Google bills the account whose Gemini API key you use.",
    ],
  },
  {
    q: "Is it a medical device?",
    a: [
      "No. AGENCY is not a medical device, a ventilator alarm or an emergency service, and it hasn't been clinically tested. It hasn't yet been evaluated with the people it's built for; that study is the next big piece of work.",
    ],
  },
  {
    q: "Does it work on Windows, iPad or Linux?",
    a: [
      "The Mac app needs a Mac for now, because it relies on macOS accessibility features to work in every app. The browser version runs in a desktop web browser. Tell us what you'd use, and we'll write back if that changes.",
    ],
  },
];
---

<Base
  title="AGENCY: use a computer with just your eyes"
  description="A free, eye-controlled computer for people who can only move their eyes, and the people who care for them. Just a webcam. Try it in your browser or download it for Mac."
>
  <!-- Hero: what it is, and the two things you can do -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-title">
        Use a computer with just your eyes<span class="gaze-stop" aria-hidden="true"></span>
      </h1>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-lede">
            AGENCY is a free, eye-controlled computer for people who can only move their eyes, and the people
            who care for them. All you need is a webcam.
          </p>
          <CtaPair class="hero-cta" />
        </div>
        <Frame
          name="food-dwell"
          eager
          class="hero-frame"
          sizes="(min-width: 84rem) 50rem, (min-width: 60rem) 58vw, 92vw"
        />
      </div>
      <ul class="hero-facts" aria-label="In short">
        <li>1st place, UCSC AI Hackathon, Cloud AI&nbsp;track</li>
        <li>Free, and becoming a nonprofit</li>
        <li>Works with the webcam you already have</li>
      </ul>
    </div>
  </section>

  <!-- See it working -->
  <section class="section on-blue" id="demo" aria-labelledby="demo-title">
    <div class="wrap">
      <div class="demo-grid">
        <div class="demo-copy">
          <p class="kicker">One minute of the real app</p>
          <h2 id="demo-title">Watch it work.</h2>
          <p>
            Ordering lunch, saying a sentence out loud and asking for help, all by looking. Captions are on,
            and it never plays by itself.
          </p>
        </div>
        {DEMO_VIDEO ? (
          <figure class="video">
            <video
              id="demo-video"
              controls
              preload="none"
              playsinline
              poster={poster.src}
              src={`${base}${DEMO_VIDEO}`}
            >
              {DEMO_CAPTIONS && (
                <track kind="captions" srclang="en" label="English" src={`${base}${DEMO_CAPTIONS}`} default />
              )}
            </video>
            <figcaption>
              Recorded on the real app with live Gemini and practice services. A scripted pointer stands in
              for the eyes.
            </figcaption>
          </figure>
        ) : (
          <div class="video-slot" role="note" aria-label="Demo video not recorded yet">
            <p>The demo video isn't recorded yet. Until it exists, this space stays empty.</p>
          </div>
        )}
      </div>
      {DEMO_VIDEO && (
        <ul class="chapters js-only" aria-label="Jump to a part of the video">
          {chapters.map((c) => (
            <li>
              <button type="button" class="btn chapter" data-seek={c.at}>
                <span class="chapter-time">{c.time}</span>
                <span>{c.label}</span>
              </button>
            </li>
          ))}
        </ul>
      )}
      <NextSection href="#how" label="How it works" />
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="how-head">
        <p class="kicker">How it works</p>
        <h2 id="how-title">Look and hold. That's the whole idea.</h2>
        <p class="lede">
          No hands, no voice and no special hardware. Here's everything there is to learn, and you can try the
          first part right here.
        </p>
      </div>
      <div class="how-grid">
        <div class="how-demo reveal">
          <DwellDemo />
        </div>
        <ol class="rules steps">
          {howTo.map((s, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <span class="step-n" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <p class="how-also">
        Eyes not reliable today? Every screen also works with a single switch, a head pointer, or a mouse and
        keyboard.
      </p>
      <NextSection href="#who" label="Who it's for" />
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section" id="who" aria-labelledby="who-title">
    <div class="wrap">
      <p class="kicker">Who it's for</p>
      <h2 id="who-title" class="who-title">
        For people who can only move their eyes, and everyone around them.
      </h2>
      <ul class="audiences">
        {audiences.map((a, i) => (
          <li class:list={["audience", `audience-${i + 1}`, "reveal"]} style={`--i:${i}`}>
            <Photo
              id={a.photo}
              class="audience-photo"
              sizes={
                i === 0
                  ? "(min-width: 84rem) 46rem, (min-width: 60rem) 55vw, 92vw"
                  : "(min-width: 84rem) 30rem, (min-width: 60rem) 36vw, 92vw"
              }
            />
            <div class="audience-copy">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="fine photo-note">
        The people in these photos aren't AGENCY users. The photos are here to show who we build for.
      </p>
      <NextSection href="#safety" label="Safety and privacy" />
    </div>
  </section>

  <!-- Safety and privacy -->
  <section class="section on-night" id="safety" aria-labelledby="safety-title">
    <div class="wrap">
      <div class="safety-grid">
        <div class="safety-copy">
          <p class="kicker">Safety and privacy</p>
          <h2 id="safety-title">You stay in charge.</h2>
          <div class="big-promise">
            <h3>Your video never leaves your computer.</h3>
            <p>
              Camera frames are processed on the device and thrown away. They're never stored and never sent
              anywhere, not even to the AI.
            </p>
          </div>
          <div class="big-promise">
            <h3>It asks before anything important.</h3>
            <p>
              Before AGENCY pays, sends, signs or calls, it shows you exactly what will happen and waits for
              your OK of that exact action. Stop works from every screen.
            </p>
          </div>
        </div>
        <Frame
          name="approve-dwell"
          class="safety-frame"
          sizes="(min-width: 84rem) 46rem, (min-width: 60rem) 55vw, 92vw"
        />
      </div>
      <ul class="rules promises">
        {promises.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
      <p class="safety-more">
        Read the <a href={`${base}privacy/`}>privacy policy</a>, and how Lifeline is designed and tested in{" "}
        <a href={`${SOURCE_URL}/blob/main/LIFELINE.md`}>LIFELINE.md</a>.
      </p>
      <NextSection href="#story" label="Our story" />
    </div>
  </section>

  <!-- Our story -->
  <section class="section" id="story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="story-main">
        <p class="kicker">Our story</p>
        <h2 class="story-quote" id="story-title">
          We built AGENCY for one person first: a team member's grandmother.
        </h2>
        <p class="story-body">
          Then we took it to the UCSC AI Hackathon, where it won 1st place in the Cloud AI track. Now we're
          turning AGENCY into a nonprofit, so it can reach more people who can only move their eyes, and the
          families who look after them.
        </p>
      </div>
      <dl class="story-facts">
        <div>
          <dt>Won</dt>
          <dd>1st place, UCSC AI Hackathon, Cloud AI track</dd>
        </div>
        <div>
          <dt>Next</dt>
          <dd>Becoming a nonprofit</dd>
        </div>
        <div>
          <dt>Built</dt>
          <dd>
            In the open. <a href={SOURCE_URL}>Read the source code on GitHub</a>.
          </dd>
        </div>
        <div>
          <dt>Made by</dt>
          <dd>
            <ul class="team">
              {TEAM.map((m) => (
                <li>{m.name}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Get it -->
  <section class="section on-blue start" id="start" aria-labelledby="start-title">
    <div class="wrap start-grid">
      <div>
        <h2 id="start-title">Free. Try it now, or put it on a Mac.</h2>
        <p class="lede">
          The browser version needs nothing but a webcam. The Mac app works in every app on the computer.
        </p>
      </div>
      <div class="start-actions">
        <CtaPair class="start-cta" />
        <p class="start-more">
          Setting it up for someone? <a href={`${base}setup/`}>Read the setup guide</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="faq-head">
        <h2 id="faq-title">Questions</h2>
        <p class="muted">
          How the AI and the network routing work, and how AGENCY compares with other tools, is on{" "}
          <a href={`${base}inside/`}>Inside AGENCY</a>.
        </p>
        <p>
          <a class="target-link" href={contactHref}>
            {contactLabel}
          </a>
        </p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="disclosure">
            <summary class="btn">{f.q}</summary>
            <div class="disclosure-body">
              {f.a.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Chapter buttons under the video: jump to a moment and play from there (only when someone asks).
  const video = document.querySelector<HTMLVideoElement>("#demo-video");
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-seek]")) {
    btn.addEventListener("click", () => {
      if (!video) return;
      video.currentTime = Number(btn.dataset["seek"] ?? 0);
      void video.play().catch(() => {});
      video.focus();
    });
  }
</script>

<style>
  /* --- Hero --- */
  .hero {
    padding-block: clamp(32px, 4.4vw, 64px) clamp(56px, 6vw, 88px);
  }
  .hero-title {
    max-width: 11.5em;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  /* The full stop is the gaze point: a blue dot inside a dwell-yellow ring, as in the app. */
  .gaze-stop {
    display: inline-block;
    position: relative;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.12em;
    border-radius: 50%;
    background: var(--blue);
    box-shadow:
      0 0 0 0.05em var(--paper),
      0 0 0 0.1em var(--yellow);
    vertical-align: 0.02em;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .hero-lede {
    font-size: clamp(1.3rem, 1.8vw, 1.6rem);
    line-height: 1.45;
    color: var(--ink);
    max-width: 30rem;
    margin-bottom: 40px;
  }
  .hero :global(.hero-cta) {
    flex-direction: column;
    max-width: 24rem;
  }
  .hero :global(.hero-cta .btn) {
    flex: none;
    max-width: none;
    width: 100%;
  }
  .hero :global(.hero-frame img) {
    box-shadow: 0 40px 80px -48px rgb(13 18 38 / 0.5);
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 0;
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 24px 0 0;
    max-width: none;
    border-top: 1px solid var(--line);
    font-weight: 700;
    font-size: 1.08rem;
  }
  .hero-facts li {
    margin: 0;
    padding-right: 28px;
    margin-right: 28px;
    border-right: 1px solid var(--line);
  }
  .hero-facts li:last-child {
    border-right: 0;
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero :global(.hero-cta) {
      flex-direction: row;
      max-width: none;
    }
    .hero :global(.hero-cta .btn) {
      flex: 1 1 16rem;
      width: auto;
      max-width: 22rem;
    }
  }
  @media (max-width: 640px) {
    .hero-facts {
      display: grid;
      gap: 12px;
    }
    .hero-facts li {
      border: 0;
      padding: 0;
      margin: 0;
    }
  }

  /* --- See it work --- */
  .demo-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }
  .demo-copy h2 {
    max-width: 9em;
  }
  .video {
    margin: 0;
  }
  .video video,
  .video-slot {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    background: #000;
    box-shadow: 0 40px 80px -40px rgb(5 8 40 / 0.7);
  }
  .video figcaption {
    margin-top: 14px;
    font-size: 0.98rem;
    color: var(--on-blue-soft);
  }
  .video-slot {
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
  }
  .chapters {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    max-width: none;
    display: none;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  :global(.js) .chapters {
    display: grid;
  }
  .chapters li {
    margin: 0;
  }
  .chapter {
    width: 100%;
    justify-content: flex-start;
    gap: 16px;
    text-align: left;
    font-size: 1.15rem;
  }
  .chapter-time {
    font-variant-numeric: tabular-nums;
    color: var(--yellow);
  }
  @media (max-width: 960px) {
    .demo-grid {
      grid-template-columns: 1fr;
    }
    .chapters {
      grid-template-columns: 1fr;
    }
  }

  /* --- How it works --- */
  .how-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 0 clamp(32px, 5vw, 80px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .how-head .kicker {
    grid-column: 1 / -1;
  }
  .how-head h2 {
    margin: 0;
  }
  .how-head .lede {
    margin: 0;
  }
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .how-demo {
    position: sticky;
    top: 32px;
  }
  .steps > li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 16px;
    padding-block: 24px;
  }
  .steps > li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .step-n {
    font-family: var(--font-display);
    font-variation-settings:
      "SOFT" 100,
      "WONK" 0;
    font-size: 2.3rem;
    line-height: 1;
    font-weight: 500;
    color: var(--blue-ink);
  }
  .steps h3 {
    margin-bottom: 6px;
  }
  .how-also {
    margin: clamp(40px, 5vw, 64px) 0 0;
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }
  @media (max-width: 960px) {
    .how-head,
    .how-grid {
      grid-template-columns: 1fr;
    }
    .how-head .lede {
      margin-top: 8px;
    }
    .how-demo {
      position: static;
    }
  }

  /* --- Who it's for --- */
  .who-title {
    max-width: 15em;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .audiences {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: clamp(32px, 4vw, 56px) clamp(32px, 5vw, 80px);
  }
  .audience {
    margin: 0;
  }
  .audience-1 {
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
  }
  .audience-1 :global(.audience-photo) {
    flex: 1 1 auto;
    min-height: 22rem;
  }
  .audience :global(.audience-photo) {
    aspect-ratio: 16 / 10;
    margin-bottom: 20px;
  }
  .audience-1 :global(.audience-photo) {
    aspect-ratio: auto;
  }
  .audience-1 h3 {
    font-family: var(--font-display);
    font-variation-settings:
      "SOFT" 100,
      "WONK" 0;
    font-weight: 560;
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .audience p {
    margin: 0;
    color: var(--ink-soft);
  }
