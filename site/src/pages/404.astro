---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---

<Base title="Page not found: AGENCY OS" description="This page doesn't exist.">
  <article class="wrap prose">
    <h1>That page doesn't exist</h1>
    <p class="lede">The link may be old, or mistyped.</p>
    <div class="actions">
      <a class="btn btn-primary" href={base}>
        Go to the home page
      </a>
      <a class="btn" href={`${base}#download`}>
        Go to the download
      </a>
    </div>
  </article>
</Base>
