---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaPair from "../components/CtaPair.astro";
const base = import.meta.env.BASE_URL;
---

<Base title="Page not found: AGENCY" description="This page doesn't exist.">
  <PageHero
    eyebrow="Page not found"
    title="That page doesn't exist"
    lede="The link may be old, or mistyped. Here's where you can go instead."
  />
  <section class="wrap prose">
    <CtaPair />
    <p class="home-link">
      <a class="target-link" href={base}>
        Go to the home page
      </a>
    </p>
  </section>
</Base>
