{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs 4331",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://127.0.0.1:4331/game/",
        "http://127.0.0.1:4331/game/download/",
        "http://127.0.0.1:4331/game/inside/",
        "http://127.0.0.1:4331/game/setup/",
        "http://127.0.0.1:4331/game/accessibility/",
        "http://127.0.0.1:4331/game/privacy/",
        "http://127.0.0.1:4331/game/credits/"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
