# AGENCY coordinator configuration. Copy to `.env` (never commit `.env`).
# Every setting is optional: with none of these set, AGENCY runs fully on this MacBook in
# deterministic demo mode.

# --- Where the coordinator listens ------------------------------------------------------
# 127.0.0.1 keeps it on this computer. Use 0.0.0.0 only on the Raspberry Pi, and only with
# AGENCY_API_TOKEN set (the coordinator refuses to start on the network without one).
AGENCY_HOST=127.0.0.1
AGENCY_PORT=8000

# Shared secret required in the X-Agency-Token header for every /api call except /api/health.
# Generate one with: backend/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENCY_API_TOKEN=

# Browser origins allowed to call the API directly (only needed when the interface talks to a
# coordinator on another machine without the Vite proxy).
AGENCY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000

# auto | local | raspberry-pi. "auto" detects a Raspberry Pi from /proc/device-tree/model.
AGENCY_NODE_ROLE=auto

# SQLite database file (cases, plans, approvals, audit trail, demo service records).
# Default: backend/data/agency.db. Use an absolute path if you change it.
# AGENCY_DB_PATH=/Users/you/agency-data/agency.db

# Pause between workflow steps so people can follow along (milliseconds). 0 = as fast as possible.
AGENCY_STEP_DELAY_MS=650

# Presenter controls: fault injection, network override, demo reset. Off by default; make demo, make dev,
# make demo-local and make backend turn them on (AGENCY_DEMO_CONTROLS=0 in the environment keeps them off).
# AGENCY_DEMO_CONTROLS=1

# --- Lifeline (emergency alerts) --------------------------------------------------------
# Where contacts' phones open their response links. Default: http://<AGENCY_HOST>:<AGENCY_PORT>,
# or http://<hostname>.local:<port> when listening on the network. Set it to an address phones
# can reach (for example http://192.168.1.20:8000) if .local names don't resolve on them.
# AGENCY_PUBLIC_URL=http://agency-pi.local:8000

# Real text messages (and, for "Text message and phone call" contacts, a voice call that reads
# the alert aloud) through Twilio. Leave empty to keep every contact on a simulated phone.
# Only contacts you explicitly switch to a real channel in Lifeline setup are ever messaged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Optional cloud reasoning ----------------------------------------------------------
# auto: use Gemini when GEMINI_API_KEY is set, else Claude when ANTHROPIC_API_KEY is set,
#       else deterministic built-in plans.
# gemini / anthropic: use only that provider.
# deterministic: never call a cloud model, even if a key is present.
AGENCY_REASONING=auto
# How hard the model thinks: low, medium or high (Gemini thinking level / Claude effort).
AGENCY_REASONING_EFFORT=medium
AGENCY_REASONING_TIMEOUT_S=25

# Google Gemini: a key from https://aistudio.google.com/apikey. AGENCY works completely
# without it. The key is read on the coordinator only and never sent to the browser.
GEMINI_API_KEY=
AGENCY_GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (alternative): a key from console.anthropic.com. A Claude Max (chat)
# subscription does NOT include API access.
ANTHROPIC_API_KEY=
AGENCY_ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (beta "server-side-fallback-2026-07-01"). Set 0 to disable.
AGENCY_ANTHROPIC_FALLBACKS=1

# --- Synapse layer (Ray's Synapse-Mesh, see ARCHITECTURE.md) -------------------------
# Synapse-Mesh's edge API on this Mac: routes every AI request (expert mixture + Cisco network budget).
# Defaults to AGENCY_LOCAL_MODEL_URL. Without it, AGENCY's stand-in router is used and says so.
# AGENCY_SYNAPSE_URL=http://127.0.0.1:8100
# Without Synapse, AGENCY times a request to the cloud model's host to watch the network (0 = off).
# AGENCY_NETWORK_PROBE=1
# AGENCY_NETWORK_INTERVAL_S=2

# --- Optional on-device model (Synapse-Mesh, see LOCAL_MODEL.md) ---------------------
# Explains approvals on this Mac when the cloud can't be reached. Must be on this computer.
# AGENCY_LOCAL_MODEL_URL=http://127.0.0.1:8100
# 1 = explanations never go to the cloud, only to the on-device model.
# AGENCY_PRIVATE_EXPLANATIONS=0
# AGENCY_LOCAL_MODEL_TIMEOUT_S=50

# --- Interface (frontend) --------------------------------------------------------------
# Used by `npm run dev` / `make dev-pi`: where Vite forwards /api. Keeps the browser on
# localhost, which the camera requires.
# AGENCY_BACKEND_URL=http://agency-pi.local:8000
