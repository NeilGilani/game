# Export these variables before starting ./run-demo.sh --dev.
# The local demo explicitly defaults to mock telemetry.
CISCO_MODE=mock

# Monitor the Edge backend to Cloud-Kernel link with a lightweight health URL:
# CISCO_MODE=cloud
# SYNAPSE_CLOUD_KERNEL_URL=https://your-cloud-kernel/health

# To connect a reserved Cisco IOS XE sandbox, use CISCO_MODE=restconf.
# Copy the HTTPS address and credentials from your sandbox reservation.
# CISCO_HOST=https://your-sandbox-host:443
# CISCO_USERNAME=your-sandbox-username
# CISCO_PASSWORD=your-sandbox-password
CISCO_VERIFY_TLS=true
CISCO_RESTCONF_PATH=/restconf/data/ietf-interfaces:interfaces-state
# Optional comma-separated uplink names; empty monitors all usable up interfaces.
CISCO_INTERFACES=
CISCO_UTILIZATION_THRESHOLD=0.7
CISCO_LATENCY_THRESHOLD_MS=150
CISCO_CRITICAL_UTILIZATION_THRESHOLD=0.95
CISCO_CRITICAL_LATENCY_THRESHOLD_MS=1000
CISCO_POLL_INTERVAL=2
# Optional adapter directory; defaults to vault-1.5b/generalist.
# SYNAPSE_GENERALIST_PATH=/absolute/path/to/generalist
